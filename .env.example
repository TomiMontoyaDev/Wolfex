NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Base de datos (Neon PostgreSQL) ── copiar a .env.local con valores reales; nunca subir al repo
# Conexión con pooler (host con "-pooler"): la usa la app.
DATABASE_URL=
# Conexión directa (sin "-pooler"): la usan las migraciones. Si se omite, se usa DATABASE_URL.
DIRECT_URL=

# ── Mercado Pago ──
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Clave secreta de webhooks (Tus integraciones > Webhooks). Recomendada en producción.
MERCADOPAGO_WEBHOOK_SECRET=

# ── Admin (/admin) ──
# Contraseña de acceso (mínimo 12 caracteres).
ADMIN_PASSWORD=
# Secreto para firmar la sesión (mínimo 32 caracteres aleatorios). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
